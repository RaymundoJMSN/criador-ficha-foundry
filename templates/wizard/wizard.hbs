<div class="t20w-wizard">
  <header class="t20w-header">
    <div class="t20w-titulo">
      <h2>{{stepTitulo}}</h2>
      <span class="t20w-passo">passo {{passoNumero}} de {{passoTotal}}</span>
    </div>
    <div class="t20w-dots" title="Clique num passo já feito para voltar a ele">
      {{#each steps}}{{#if this.done}}<button type="button" data-action="goStep" data-step="{{this.id}}" title="{{localize this.label}}"></button>{{else}}<span class="{{#if this.active}}ativo{{/if}}" title="{{localize this.label}}"></span>{{/if}}{{/each}}
    </div>
  </header>
  {{#if regrasDaMesa.length}}
  <div class="t20w-regras">Regras da mesa: {{#each regrasDaMesa}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</div>
  {{/if}}

  <div class="t20w-content">

    {{#if showNivel}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <div class="form-group">
        <label for="t20w-nivel">Nível</label>
        <input id="t20w-nivel" type="number" name="nivel" min="1" max="20" value="{{nivelGrupo}}" />
        {{#if nivelExtra}}<span class="t20w-hint">Nível do grupo. Pela faixa etária, o personagem joga no {{state.nivel}}º.</span>{{/if}}
      </div>
      <div class="form-group">
        <label for="t20w-nome">Nome do Personagem</label>
        <input id="t20w-nome" type="text" name="nome" value="{{state.nome}}" placeholder="Nome..." />
      </div>
    </section>
    {{/if}}

    {{#if showAtributos}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <div class="form-group">
        <label>Método</label>
        {{#if metodoFixo}}
        <strong>{{metodoDescricao}}</strong> <span class="t20w-hint">(definido pelo mestre)</span>
        {{else}}
        <select name="metodoAtributos">
          {{#each metodos}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.nome}} ({{this.categoria}})</option>
          {{/each}}
        </select>
        {{/if}}
      </div>
      <p class="t20w-hint" style="margin:6px 0 10px;">{{metodoTexto}}</p>

      {{#if isCompra}}
      <div style="display:flex;flex-direction:column;gap:6px;">
        {{#each atributos}}
        <div class="t20w-attr-row" style="display:flex;align-items:center;gap:8px;">
          <span style="width:110px;font-size:0.9em;">{{this.label}}</span>
          <button type="button" class="t20w-btn-sm" data-action="attrDec" data-attr="{{this.id}}" style="width:26px;height:26px;padding:0;font-size:1em;line-height:1;cursor:pointer;">−</button>
          <input type="number" name="attr-{{this.id}}" value="{{this.value}}"
            class="t20w-attr-input" data-attr="{{this.id}}"
            style="width:52px;text-align:center;" min="-1" max="4" />
          <button type="button" class="t20w-btn-sm" data-action="attrInc" data-attr="{{this.id}}" style="width:26px;height:26px;padding:0;font-size:1em;line-height:1;cursor:pointer;">+</button>
          <span class="t20w-custo" style="font-size:0.8em;opacity:0.7;width:60px;">custo: {{this.custo}}</span>
        </div>
        {{/each}}
      </div>
      <p style="margin-top:10px;font-size:0.9em;">
        Pontos restantes: <strong id="t20w-pontos-restantes" class="{{#if pontosNegativo}}t20w-over{{/if}}">{{pontosRestantes}}</strong> / {{pontosTotal}}
      </p>
      {{/if}}

      {{#if podeRolar}}
      <div class="t20w-roll-bar" style="margin-bottom:10px;">
        <button type="button" data-action="rollAtributos" class="t20w-btn" style="padding:4px 12px;cursor:pointer;">🎲 {{#if precisaRolar}}Rolar{{else}}Rolar de novo{{/if}}</button>
      </div>
      {{/if}}

      {{#if isPool}}{{#unless precisaRolar}}
      <p style="font-size:0.9em;margin:0 0 6px;">Valores: {{#each pool}}<span class="t20w-chip">{{this}}</span>{{/each}}</p>
      <div style="display:flex;flex-direction:column;gap:6px;">
        {{#each atributos}}
        <div class="t20w-attr-row" style="display:flex;align-items:center;gap:8px;">
          <span style="width:110px;font-size:0.9em;">{{this.label}}</span>
          <select name="dist-{{this.id}}" class="t20w-dist" style="width:70px;">
            {{#each this.opcoes}}<option value="{{this.valor}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </div>
        {{/each}}
      </div>
      {{/unless}}{{/if}}

      {{#if isValkaria}}{{#unless precisaRolar}}
      <div style="display:flex;gap:16px;flex-wrap:wrap;">
        <div style="display:flex;flex-direction:column;gap:6px;">
          {{#each dados}}
          <div class="t20w-attr-row" style="display:flex;align-items:center;gap:8px;">
            <span class="t20w-chip">{{this.valor}}</span>
            <span style="opacity:0.7;">→</span>
            <select name="vdado-{{this.idx}}" class="t20w-vdado" style="width:120px;">
              {{#each this.opcoes}}<option value="{{this.valor}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
            </select>
          </div>
          {{/each}}
        </div>
        <table class="t20w-mini" style="font-size:0.85em;align-self:flex-start;">
          <tr><th style="text-align:left;">Atributo</th><th>Total</th><th>Valor</th></tr>
          {{#each valkariaTotais}}<tr><td>{{this.label}}</td><td style="text-align:center;">{{this.total}}</td><td style="text-align:center;"><strong>{{this.value}}</strong></td></tr>{{/each}}
        </table>
      </div>
      {{/unless}}{{/if}}
    </section>
    {{/if}}

    {{#if showRaca}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <div class="form-group">
        <label for="t20w-raca-sel">Raça</label>
        <select id="t20w-raca-sel" name="racaId" style="width:100%;padding:6px;">
          <option value="">— escolha uma raça —</option>
          {{#each racaOptions}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </div>
      {{#if selectedDetail}}
      <div class="t20w-card">
        <h3 style="margin:0 0 6px;">{{selectedDetail.name}}</h3>
        {{#if selectedDetail.descricao}}<p style="font-size:0.85em;opacity:0.8;margin:0 0 8px;">{{selectedDetail.descricao}}</p>{{/if}}
        <dl style="display:grid;grid-template-columns:max-content 1fr;gap:2px 12px;font-size:0.85em;margin:0;">
          {{#if selectedDetail.atributosTexto}}<dt>Atributos</dt><dd>{{selectedDetail.atributosTexto}}</dd>{{/if}}
          <dt>Tamanho</dt><dd>{{selectedDetail.tamanho}}</dd>
          <dt>Deslocamento</dt><dd>{{selectedDetail.deslocamento}}</dd>
          {{#if selectedDetail.periciasBonus.length}}<dt>Perícias bônus</dt><dd>{{#each selectedDetail.periciasBonus}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</dd>{{/if}}
        </dl>
        {{#if selectedDetail.poderesRaciais.length}}
        <div style="margin-top:10px;">
          <strong style="font-size:0.85em;">Habilidades de {{selectedDetail.name}}:</strong>
          <ul style="margin:6px 0 0;padding-left:0;list-style:none;display:flex;flex-direction:column;gap:4px;">
            {{#each selectedDetail.poderesRaciais}}
            <li style="font-size:0.85em;background:rgba(255,255,255,0.04);border-radius:3px;padding:5px 8px;">
              <strong>{{this.nome}}</strong>
              {{#if this.descricao}}<div style="opacity:0.75;margin-top:2px;">{{this.descricao}}</div>{{/if}}
            </li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
        {{#each selectedDetail.escolhasRaciais}}
        <div class="t20w-card">
          <strong style="font-size:0.85em;">{{this.habilidade}}</strong>
          {{#if this.ramos.length}}
          <div style="display:flex;flex-direction:column;gap:4px;margin-top:6px;">
            {{#each this.ramos}}
            <label for="ramo-{{../this.chave}}-{{this.id}}" class="t20w-opcao">
              <input type="radio" id="ramo-{{../this.chave}}-{{this.id}}"
                     name="raca_esc-{{../this.chave}}_ramo" value="{{this.id}}"
                     {{#if this.selected}}checked{{/if}} />
              <span>{{this.rotulo}}</span>
            </label>
            {{/each}}
          </div>
          {{/if}}
          {{#each this.pickers}}
          <div class="form-group" style="margin-top:6px;">
            <label for="raca-pick-{{this.name}}" style="font-size:0.8em;">{{this.label}}</label>
            <select id="raca-pick-{{this.name}}" name="raca_esc-{{this.name}}" style="width:100%;padding:5px;">
              <option value="">—</option>
              {{#each this.opcoes}}
              <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.nome}}</option>
              {{/each}}
            </select>
          </div>
          {{/each}}
        </div>
        {{/each}}
        {{#if selectedDetail.racaAberta}}
        <div style="margin-top:10px;">
          <strong style="font-size:0.85em;">Raças Abertas — aplique cada modificador da raça no atributo que quiser:</strong>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;">
            {{#each selectedDetail.racaAberta.slots}}
            <label style="display:flex;align-items:center;gap:4px;"><span class="t20w-chip">{{this.valor}}</span>
              <select class="t20w-raca-aberta" data-idx="{{this.idx}}" style="padding:4px;">
                <option value="">—</option>
                {{#each this.opcoes}}<option value="{{this.code}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
              </select></label>
            {{/each}}
          </div>
          {{#each selectedDetail.racaAberta.erros}}<div class="t20w-hint" style="color:#f90;">{{this}}</div>{{/each}}
        </div>
        {{/if}}
        {{#each selectedDetail.modGroups}}
        <div style="margin-top:10px;">
          <strong style="font-size:0.85em;">{{this.titulo}}:</strong>
          {{#if this.observacao}}<div style="font-size:0.8em;opacity:0.7;">{{this.observacao}}</div>{{/if}}
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;">
            {{#each this.slots}}
            <select name="raca_mod-{{this.groupIndex}}-{{this.slotIndex}}" style="padding:4px;">
              <option value="">—</option>
              {{#each this.opcoes}}
              <option value="{{this.code}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
            {{/each}}
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}
    </section>
    {{/if}}

    {{#if showIdade}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <p class="t20w-hint">Regras opcionais de Heróis de Arton (cap. 4), ligadas pelo mestre.</p>

      {{#if mostraFaixas}}
      <h3 style="font-size:0.95em;margin:10px 0 4px;">Faixa etária</h3>
      <div style="display:flex;flex-direction:column;gap:3px;">
        {{#each faixas}}
        <label class="t20w-opcao"><input type="radio" name="idade_faixa" value="{{this.id}}" {{#if this.selected}}checked{{/if}} /><span><strong>{{this.nome}}</strong> <small style="opacity:0.7;">({{this.idades}} anos)</small> — {{this.resumo}}</span></label>
        {{/each}}
      </div>
      {{/if}}

      {{#if mostraJaViCoisas}}
      <h3 style="font-size:0.95em;margin:12px 0 4px;">Já Vi Coisas</h3>
      <label class="t20w-opcao"><input type="checkbox" name="idade_ja_vi_coisas" {{#if jaViCoisas}}checked{{/if}} /><span>Receber <strong>um poder geral</strong> em troca de <strong>uma complicação de idade</strong> a mais.</span></label>
      {{/if}}

      {{#if complicacoesIdadeExigidas}}
      <h3 style="font-size:0.95em;margin:12px 0 4px;">Complicações de idade — escolha {{complicacoesIdadeExigidas}}</h3>
      <div class="t20w-scroll t20w-lista" style="max-height:260px;overflow-y:auto;">
        {{#each complicacoesIdade}}
        <label class="t20w-opcao"><input type="checkbox" name="compl_idade-{{this.id}}" value="{{this.id}}" {{#if this.selected}}checked{{/if}} {{#if this.bloqueado}}disabled{{/if}} /><span><strong>{{this.nome}}</strong> — {{this.resumo}}</span></label>
        {{/each}}
      </div>
      {{/if}}

      {{#if mostraComplicacao}}
      <h3 style="font-size:0.95em;margin:12px 0 4px;">Complicação <small style="opacity:0.7;font-weight:normal;">(opcional: uma, em troca de um poder geral)</small></h3>
      <select name="complicacao" class="t20w-busca-select-alvo" style="width:100%;">
        <option value="">— nenhuma —</option>
        {{#each complicacoes}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}{{#if this.classe}} ({{this.classe}}){{/if}}</option>{{/each}}
      </select>
      {{#each complicacoes}}{{#if this.selected}}<p class="t20w-hint" style="margin-top:6px;">{{this.descricao}}</p>{{/if}}{{/each}}
      {{/if}}

      {{#if poderesGeraisExtras}}
      <p style="margin-top:12px;font-size:0.9em;">Poderes gerais extras no passo Poderes: <strong>+{{poderesGeraisExtras}}</strong></p>
      {{/if}}
    </section>
    {{/if}}

    {{#if showOrigem}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <div class="form-group">
        <label for="t20w-origem-sel">Origem</label>
        <select id="t20w-origem-sel" name="origemId" style="width:100%;padding:6px;">
          <option value="">— escolha uma origem —</option>
          {{#each origemOptions}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.nome}}</option>
          {{/each}}
        </select>
      </div>
      {{#if selectedDetail}}
      <div class="t20w-card">
        <h3 style="margin:0 0 6px;">{{selectedDetail.nome}}</h3>
        {{#if selectedDetail.descricao}}<p style="font-size:0.85em;opacity:0.8;margin:0 0 8px;">{{selectedDetail.descricao}}</p>{{/if}}
        {{#if selectedDetail.pericias.length}}<p style="font-size:0.85em;margin:0 0 4px;"><strong>Perícias:</strong> {{#each selectedDetail.pericias}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
        {{#if selectedDetail.itens_iniciais.length}}<p style="font-size:0.85em;margin:0 0 4px;"><strong>Itens iniciais:</strong></p><ul style="font-size:0.82em;margin:0 0 6px;padding-left:18px;">{{#each selectedDetail.itens_iniciais}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
        {{#if selectedDetail.beneficios.length}}
        <div style="margin-top:8px;">
          <strong style="font-size:0.85em;">
            {{#if selectedDetail.beneficiosAuto}}Benefícios (todos){{else}}Escolha {{selectedDetail.beneficiosQtd}} benefícios — perícias e/ou poderes ({{selectedDetail.beneficiosMarcados}}/{{selectedDetail.beneficiosQtd}}){{/if}}
          </strong>
          <div style="display:flex;flex-direction:column;gap:4px;margin-top:6px;">
            {{#each selectedDetail.beneficios}}
            <label for="origem-ben-{{@index}}" style="display:flex;align-items:center;gap:6px;font-size:0.9em;cursor:pointer;">
              <input type="checkbox" id="origem-ben-{{@index}}" name="origem_beneficio" value="{{this.token}}" {{#if this.selected}}checked{{/if}} {{#if ../selectedDetail.beneficiosAuto}}disabled{{/if}} style="flex-shrink:0;" />
              <span style="cursor:pointer;">{{this.nome}}{{#if this.exclusivo}} <em style="opacity:0.7;">(exclusivo)</em>{{/if}}</span>
            </label>
            {{/each}}
          </div>
        </div>
        {{/if}}
        {{#each selectedDetail.poderesLivres}}
        <div class="form-group" style="margin-top:10px;">
          <label for="origem-livre-{{this.categoria}}">{{this.label}}</label>
          <select id="origem-livre-{{this.categoria}}" name="origem_poder_livre"
                  data-categoria="{{this.categoria}}" style="width:100%;padding:6px;">
            <option value="">— escolha um poder —</option>
            {{#each this.opcoes}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.nome}}</option>
            {{/each}}
          </select>
        </div>
        {{/each}}
      </div>
      {{/if}}
    </section>
    {{/if}}

    {{#if showClasse}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <div class="form-group">
        <label for="t20w-classe-sel">Classe</label>
        <select id="t20w-classe-sel" name="classeId" style="width:100%;padding:6px;">
          <option value="">— escolha uma classe —</option>
          {{#each classes}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </div>
      {{#if selectedClasse}}
      <div class="t20w-card">
        <h3 style="margin:0 0 6px;">{{selectedClasse.name}}</h3>
        {{#if descricao}}<p style="font-size:0.85em;opacity:0.8;margin:0 0 8px;">{{descricao}}</p>{{/if}}
        {{#if selectedClasse.system.descricao}}<p style="font-size:0.85em;opacity:0.8;margin:0 0 8px;">{{selectedClasse.system.descricao}}</p>{{/if}}
        <dl style="display:grid;grid-template-columns:max-content 1fr;gap:2px 12px;font-size:0.85em;margin:0;">
          <dt>PV por nível</dt><dd>+{{selectedClasse.system.pvPorNivel}}</dd>
          <dt>PM por nível</dt><dd>+{{selectedClasse.system.pmPorNivel}}</dd>
        </dl>
      </div>
      {{/if}}
      {{#if selectedClasse}}
      <div class="t20w-multiclasse" class="t20w-card">
        <strong style="font-size:0.9em;">Multiclasse</strong>
        <span class="t20w-hint"> — opcional (LB p.35). {{selectedClasse.name}} fica com {{multiclasse.principalNiveis}} nível(is); só ela dá perícias e proficiências.</span>
        {{#each multiclasse.linhas}}
        <div style="display:flex;align-items:center;gap:8px;margin-top:6px;">
          <select class="t20w-mc-classe" data-idx="{{this.idx}}" style="flex:1;padding:4px;">
            <option value="">— classe —</option>
            {{#each this.opcoes}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}
          </select>
          <label style="font-size:0.85em;">níveis <input type="number" class="t20w-mc-niveis" data-idx="{{this.idx}}" value="{{this.niveis}}" min="1" max="19" style="width:56px;" /></label>
          <button type="button" class="t20w-btn-sm" data-action="mcRemove" data-idx="{{this.idx}}" title="Remover" style="width:24px;height:24px;padding:0;cursor:pointer;">×</button>
        </div>
        {{/each}}
        {{#each multiclasse.erros}}<div class="t20w-hint" style="color:#f90;margin-top:4px;">{{this}}</div>{{/each}}
        {{#if multiclasse.podeAdicionar}}
        <button type="button" class="t20w-btn-sm" data-action="mcAdd" style="margin-top:8px;padding:2px 10px;cursor:pointer;">+ outra classe</button>
        {{/if}}
      </div>
      {{/if}}
      {{#each caminhosPorClasse}}
      <div class="t20w-caminho-section" class="t20w-card">
        <strong style="font-size:0.9em;">Caminho{{#unless this.principal}} de {{this.classeNome}}{{/unless}}:</strong>
        <div style="display:flex;flex-direction:column;gap:6px;margin-top:8px;">
          {{#each this.caminhos}}
          <label for="{{../chave}}-{{this.slug}}" style="display:flex;align-items:center;gap:8px;font-size:0.9em;cursor:pointer;width:100%;">
            <input type="radio" id="{{../chave}}-{{this.slug}}" name="{{../chave}}" value="{{this.slug}}"
              {{#if this.selected}}checked{{/if}}
              style="flex-shrink:0;">
            <span style="cursor:pointer;">{{this.nome}}</span>
          </label>
          {{/each}}
        </div>
        {{#each this.subEscolhas}}
        <div class="form-group" style="margin-top:10px;">
          <label for="sub-{{this.chave}}">{{this.label}}</label>
          <select id="sub-{{this.chave}}" name="subescolha" data-chave="{{this.chave}}" style="width:100%;padding:6px;">
            <option value="">— escolha —</option>
            {{#each this.opcoes}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.nome}}</option>
            {{/each}}
          </select>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{#if showPericias}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      {{#unless hasClasse}}<p style="opacity:0.7;">Escolha uma classe antes de definir perícias.</p>{{/unless}}

      {{#if fixas.length}}
      <div style="margin-bottom:10px;">
        <strong style="font-size:0.85em;">Treinadas pela classe:</strong>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;">
          {{#each fixas}}<span style="font-size:0.8em;padding:2px 8px;background:#3a3a3a;border-radius:3px;">{{this.nome}}</span>{{/each}}
        </div>
      </div>
      {{/if}}

      {{#each obrigatorias}}
      <div style="margin-bottom:10px;">
        <strong style="font-size:0.85em;">Escolha {{this.quantidade}} (obrigatória):</strong>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;">
          {{#each this.opcoes}}
          <label style="font-size:0.9em;display:flex;align-items:center;gap:4px;">
            <input type="radio" name="per_obrig-{{../groupIndex}}" value="{{this.id}}" {{#if this.checked}}checked{{/if}} />{{this.nome}}
          </label>
          {{/each}}
        </div>
      </div>
      {{/each}}

      {{#if escolhasQtd}}
      <div style="margin-bottom:10px;">
        <strong style="font-size:0.85em;">Perícias da classe — escolha {{escolhasQtd}} (restam {{escolhasRestantes}}):</strong>
        {{#if listaIncompleta}}<div style="font-size:0.78em;opacity:0.7;margin:2px 0 4px;">O compêndio não traz a lista de perícias desta classe — escolha entre todas e confira no livro.</div>{{/if}}
        <div class="t20w-pcheck-group" data-group="esc" data-max="{{escolhasQtd}}" style="display:grid;grid-template-columns:repeat(2,1fr);gap:2px 12px;margin-top:4px;max-height:200px;overflow-y:auto;">
          {{#each escolhasOpcoes}}
          <label style="font-size:0.88em;display:flex;align-items:center;gap:6px;" class="{{#if this.disabled}}t20w-disabled{{/if}}">
            <input type="checkbox" name="per_esc-{{this.id}}" value="{{this.id}}" {{#if this.checked}}checked{{/if}} {{#if this.disabled}}disabled{{/if}} />{{this.nome}}
          </label>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if intBonus}}
      <div style="margin-bottom:10px;">
        <strong style="font-size:0.85em;">Perícias extras por Inteligência — até {{intBonus}} (qualquer):</strong>
        <div class="t20w-pcheck-group" data-group="int" data-max="{{intBonus}}" style="display:grid;grid-template-columns:repeat(2,1fr);gap:2px 12px;margin-top:4px;max-height:160px;overflow-y:auto;">
          {{#each intOpcoes}}
          <label style="font-size:0.88em;display:flex;align-items:center;gap:6px;" class="{{#if this.disabled}}t20w-disabled{{/if}}">
            <input type="checkbox" name="per_int-{{this.id}}" value="{{this.id}}" {{#if this.checked}}checked{{/if}} {{#if this.disabled}}disabled{{/if}} />{{this.nome}}
          </label>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if racaBonus}}
      <div style="margin-bottom:10px;">
        <strong style="font-size:0.85em;">Perícias de raça — escolha {{racaBonus}} (qualquer):</strong>
        <div class="t20w-pcheck-group" data-group="raca" data-max="{{racaBonus}}" style="display:grid;grid-template-columns:repeat(2,1fr);gap:2px 12px;margin-top:4px;max-height:160px;overflow-y:auto;">
          {{#each racaOpcoes}}
          <label style="font-size:0.88em;display:flex;align-items:center;gap:6px;" class="{{#if this.disabled}}t20w-disabled{{/if}}">
            <input type="checkbox" name="per_raca-{{this.id}}" value="{{this.id}}" {{#if this.checked}}checked{{/if}} {{#if this.disabled}}disabled{{/if}} />{{this.nome}}
          </label>
          {{/each}}
        </div>
      </div>
      {{/if}}

    </section>
    {{/if}}

    {{#if showDivindade}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      {{#if obrigatoria}}<p style="color:#f90;font-size:0.9em;">⚠ Esta classe exige uma divindade.</p>
      {{else}}<p style="font-size:0.9em;opacity:0.7;">Opcional. Pule se não quiser ser devoto.</p>{{/if}}
      <div class="form-group">
        <label for="t20w-div-sel">Divindade</label>
        <select id="t20w-div-sel" name="divindadeId" style="width:100%;padding:6px;">
          <option value="">— nenhuma —</option>
          {{#each divindades}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.nome}}</option>
          {{/each}}
        </select>
      </div>
      {{#if selectedDivindade}}
      <div class="t20w-card">
        <h3 style="margin:0 0 6px;">{{selectedDivindade.nome}}</h3>
        <p style="font-size:0.85em;margin:0 0 6px;">
          <strong>Escolha {{quantosPoderes}} poder(es) concedido(s):</strong>
        </p>
        <div style="display:flex;flex-direction:column;gap:4px;">
          {{#each selectedDivindade.poderes}}
          <label for="div-poder-{{@index}}" class="t20w-opcao">
            <input type="checkbox" id="div-poder-{{@index}}" name="divindade_poder"
                   value="{{this.slug}}" {{#if this.selected}}checked{{/if}} />
            <span>{{this.nome}}</span>
          </label>
          {{/each}}
        </div>
      </div>
      {{/if}}
    </section>
    {{/if}}

    {{#if showPoderes}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <input type="hidden" name="passo_poderes" value="1" />

      {{#if semTabela}}
      <p class="t20w-hint" style="color:#f90;">Esta classe existe no compêndio, mas nenhum livro disponível traz sua tabela de progressão — habilidades e poderes de classe terão de ser postos na ficha à mão.</p>
      {{/if}}
      {{#if habilidades.length}}
      <div style="margin-bottom:16px;">
        <h3 style="font-size:0.95em;margin:0 0 6px 0;opacity:0.8;">Habilidades de Classe</h3>
        <p class="t20w-hint" style="margin:0 0 6px 0;">Você recebe estas habilidades automaticamente:</p>
        <ul style="margin:0;padding-left:20px;">
          {{#each habilidades}}<li style="font-size:0.85em;">{{this.nome}}{{#if this.opcoes.length}}:
            <select class="t20w-habilidade" data-slug="{{this.slug}}" style="margin-left:4px;padding:2px 4px;">
              <option value="">— escolha —</option>
              {{#each this.opcoes}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.nome}}</option>{{/each}}
            </select>{{/if}}</li>{{/each}}
        </ul>
      </div>
      {{/if}}

      {{#if poderesParaPick}}
      <div>
        <h3 style="font-size:0.95em;margin:0 0 6px 0;opacity:0.8;">Escolha de Poderes</h3>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;flex-wrap:wrap;">
          <span style="font-size:0.9em;">Escolha <strong>{{poderesParaPick}}</strong>{{#if extrasGerais}} <small style="opacity:0.7;">({{extrasGerais}} extra(s) por complicação, só gerais)</small>{{/if}} — Selecionados: <strong>{{selectedCount}}</strong></span>
          <select id="t20w-poder-cat" style="padding:4px 8px;background:rgba(255,255,255,0.08);border:1px solid #555;color:inherit;border-radius:3px;">
            <option value="">Todas as categorias</option>
            {{#each categorias}}<option value="{{this}}">{{this}}</option>{{/each}}
          </select>
          <input type="text" id="t20w-poder-search" placeholder="Filtrar poderes..."
                 style="flex:1;min-width:120px;padding:4px 8px;background:rgba(255,255,255,0.08);border:1px solid #555;color:inherit;border-radius:3px;" />
        </div>

        <div class="t20w-poderes-list t20w-scroll t20w-lista" style="max-height:360px;overflow-y:auto;">
          {{#each poderes}}
          <label class="t20w-poder-row t20w-item{{#if this.selected}} selecionado{{/if}}{{#unless this.eligible}} inelegivel{{/unless}}"
                 data-poder-name="{{this.name}}"
                 data-poder-cat="{{this.tipo}}">
            <input type="checkbox" name="poder-{{this.id}}" value="{{this.id}}"
                   {{#if this.selected}}checked{{/if}} {{#if this.bloqueado}}disabled{{/if}} />
            <img src="{{this.img}}" onerror="this.style.display='none'" />
            <div class="t20w-corpo">
              <div class="t20w-row">
                <span class="t20w-nome">{{this.name}}</span>
                {{#if this.tipo}}<span class="t20w-badge">{{this.tipo}}</span>{{/if}}
                {{#if this.repetivel}}
                  {{#if this.selected}}
                  <span style="margin-left:auto;display:flex;align-items:center;gap:4px;font-size:0.8em;">
                    <button type="button" class="t20w-btn-sm" data-action="poderMenos" data-id="{{this.id}}" style="width:20px;height:20px;padding:0;line-height:1;cursor:pointer;">−</button>
                    <strong>×{{this.vezes}}</strong>
                    <button type="button" class="t20w-btn-sm" data-action="poderMais" data-id="{{this.id}}" style="width:20px;height:20px;padding:0;line-height:1;cursor:pointer;" {{#unless this.podeMais}}disabled{{/unless}}>+</button>
                  </span>
                  {{else}}
                  <small style="opacity:0.55;font-size:0.72em;">(repetível)</small>
                  {{/if}}
                {{/if}}
              </div>
              {{#if this.descricao}}<details class="t20w-mais"><summary>descrição</summary><div class="t20w-desc">{{this.descricao}}</div></details>{{/if}}
              {{#unless this.eligible}}
                <div class="t20w-requer">Requer: {{#each this.unmet}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</div>
              {{/unless}}
            </div>
          </label>
          {{/each}}
        </div>
      </div>
      {{else}}
      {{#unless habilidades.length}}
      <p class="t20w-hint">Nenhuma habilidade ou poder disponível para esta classe/nível.</p>
      {{/unless}}
      {{/if}}

    </section>
    {{/if}}

    {{#if showMagias}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <input type="hidden" name="passo_magias" value="1" />
      {{#if isConjurador}}
      {{#if escolasAEscolher}}
      <div class="t20w-card" style="margin:0 0 10px;">
        <strong style="font-size:0.9em;">Escolha {{escolasAEscolher}} escolas de magia</strong>
        <span style="font-size:0.8em;opacity:0.7;"> — escolha permanente; só magias dessas escolas.{{#if escolasFaltam}} Faltam {{escolasFaltam}}.{{/if}}</span>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-top:6px;">
          {{#each escolas}}
          <label class="t20w-opcao"><input type="checkbox" name="escola-{{this.abrev}}" value="{{this.abrev}}" {{#if this.selected}}checked{{/if}} {{#if this.bloqueado}}disabled{{/if}} /><span>{{this.nome}}</span></label>
          {{/each}}
        </div>
      </div>
      {{/if}}
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;flex-wrap:wrap;">
        <span style="font-size:0.9em;" class="{{#if excesso}}t20w-over{{/if}}">Selecionadas: <strong>{{selectedCount}}</strong> / {{magiaLimit}}</span>
        {{#if excesso}}<span style="color:#f55;font-size:0.85em;">⚠ Remova {{excesso}}</span>{{else}}{{#if atMaxLimit}}<span style="color:#f90;font-size:0.85em;">✓ Limite atingido</span>{{/if}}{{/if}}
        <input type="text" id="t20w-magia-search" placeholder="Buscar magia..."
               value="{{magiaSearch}}"
               style="flex:1;min-width:120px;padding:4px 8px;background:rgba(255,255,255,0.08);border:1px solid #555;color:inherit;border-radius:3px;" />
      </div>
      {{#each magiasByCirculo}}
      <div style="margin-bottom:14px;">
        <h3 style="font-size:0.9em;margin:0 0 6px;opacity:0.8;">{{label}}{{#if teto}} <small style="opacity:0.7;">(até {{teto}} deste círculo para cima)</small>{{/if}}</h3>
        <div class="t20w-scroll t20w-lista" style="max-height:260px;overflow-y:auto;">
          {{#each magias}}
          <label class="t20w-item{{#if this.selected}} selecionado{{/if}}{{#if this.excedente}} excedente{{/if}}" style="align-items:center;">
            <input type="checkbox" name="magia-{{this.id}}" value="{{this.id}}" {{#if this.selected}}checked{{/if}} {{#if this.bloqueado}}disabled{{/if}} />
            <img src="{{this.img}}" onerror="this.style.display='none'" />
            <div class="t20w-corpo">
              <span class="t20w-nome">{{this.name}}</span>
              <span class="t20w-badge">{{this.escola}}</span>{{#if this.tipo}}<span class="t20w-badge">{{this.tipo}}</span>{{/if}}
            </div>
          </label>
          {{/each}}
        </div>
      </div>
      {{else}}
      <p class="t20w-hint" style="opacity:0.7;">{{#if escolasFaltam}}Marque as escolas acima para ver as magias.{{else}}Nenhuma magia disponível para esta classe/nível{{#if magiaSearch}} com esse filtro{{/if}}.{{/if}}</p>
      {{/each}}
      {{else}}
      <p class="t20w-hint">{{classeNome}} não conjura magias. Clique em Próximo.</p>
      {{/if}}
    </section>
    {{/if}}

    {{#if showEquipamento}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>

      <div class="t20w-money-bar t20w-barra">
        <span>Dinheiro inicial: <strong>{{dinheiroInicial}} T$</strong>{{#if isNivel1}} <span style="opacity:0.6;font-size:0.85em;">(4d6{{#if dinheiroFixo}} + origem{{/if}})</span>{{/if}}</span>
        <span style="opacity:0.5;">|</span>
        <span>Gasto: {{dinheiroGasto}} T$</span>
        <span style="opacity:0.5;">|</span>
        <span class="{{#if dinheiroOk}}t20w-money-ok{{else}}t20w-over{{/if}}" style="font-weight:600;">Restante: {{dinheiroRestante}} T$</span>
        {{#unless dinheiroOk}}<span style="color:#f55;font-size:0.85em;">⚠ Excedeu o orçamento!</span>{{/unless}}
      </div>

      {{#if escolhas.length}}
      <div class="t20w-card" style="margin:0 0 10px;">
        <strong style="font-size:0.85em;">Itens iniciais — escolha:</strong>
        {{#each escolhas}}
        <div style="display:flex;align-items:center;gap:8px;margin-top:4px;font-size:0.85em;flex-wrap:wrap;">
          <span style="min-width:120px;">{{this.label}}</span>
          {{#if this.opcoes.length}}
          <select class="t20w-item-inicial" data-chave="{{this.chave}}" style="max-width:260px;">
            {{#each this.opcoes}}<option value="{{this.valor}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
          {{/if}}
          {{#if this.sub}}
          <select class="t20w-item-inicial" data-chave="{{this.chave}}_item" style="max-width:260px;">
            {{#each this.sub}}<option value="{{this.valor}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{/if}}

      <!-- Search -->
      <input type="text" id="t20w-equip-search" placeholder="Buscar item..." value="{{equipSearch}}"
        style="width:100%;box-sizing:border-box;padding:4px 8px;background:rgba(255,255,255,0.08);border:1px solid #555;color:inherit;border-radius:3px;margin-bottom:8px;" />

      <!-- Category tabs -->
      <div class="t20w-equip-tabs t20w-tabs">
        <button type="button" class="t20w-tab{{#if (eq categoriaAtual 'arma')}} ativa{{/if}}" data-action="equipTab" data-categoria="arma">Armas</button>
        <button type="button" class="t20w-tab{{#if (eq categoriaAtual 'armadura')}} ativa{{/if}}" data-action="equipTab" data-categoria="armadura">Armaduras</button>
        <button type="button" class="t20w-tab{{#if (eq categoriaAtual 'geral')}} ativa{{/if}}" data-action="equipTab" data-categoria="geral">Geral</button>
        <button type="button" class="t20w-tab{{#if (eq categoriaAtual 'consumivel')}} ativa{{/if}}" data-action="equipTab" data-categoria="consumivel">Consumíveis</button>
      </div>

      <div class="t20w-equip-layout" style="display:grid;grid-template-columns:1fr 220px;gap:10px;">
        <!-- Item list -->
        <div class="t20w-equip-list t20w-scroll t20w-lista" style="max-height:340px;overflow-y:auto;">
          {{#each itens}}
          <div class="t20w-equip-row t20w-item{{#if selected}} selecionado{{/if}}" style="align-items:center;cursor:default;font-size:0.88em;">
            <img src="{{img}}" alt="" onerror="this.style.display='none'" />
            <span class="t20w-corpo" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{name}}</span>
            <span style="opacity:0.7;white-space:nowrap;">{{preco}} T$</span>
            <span style="opacity:0.5;white-space:nowrap;font-size:0.8em;">{{peso}} kg</span>
            {{#if selected}}
            <button type="button" class="t20w-btn-sm" data-action="equipRemove" data-id="{{id}}"
              style="width:24px;height:24px;padding:0;font-size:1.1em;line-height:1;cursor:pointer;flex-shrink:0;">−</button>
            <span style="min-width:18px;text-align:center;">{{qty}}</span>
            {{/if}}
            <button type="button" class="t20w-btn-sm" data-action="equipAdd" data-id="{{id}}"
              style="width:24px;height:24px;padding:0;font-size:1.1em;line-height:1;cursor:pointer;flex-shrink:0;">+</button>
          </div>
          {{else}}
          <p class="t20w-hint" style="opacity:0.6;font-size:0.85em;">Nenhum item nesta categoria{{#if equipSearch}} com esse filtro{{/if}}.</p>
          {{/each}}
        </div>

        <!-- Cart -->
        <div class="t20w-cart t20w-card" style="margin:0;display:flex;flex-direction:column;gap:4px;max-height:340px;overflow-y:auto;">
          <h3 style="margin:0 0 6px;">Carrinho</h3>
          {{#if gratis.length}}
          <div style="margin-bottom:6px;">
            <strong style="font-size:0.8em;opacity:0.8;">Grátis (origem{{#if isNivel1}} + kit inicial{{/if}}):</strong>
            {{#each gratis}}
            <div style="font-size:0.8em;padding:2px 4px;opacity:0.75;" title="{{this.nota}}">{{this.label}}{{#if (gt this.qtd 1)}} ×{{this.qtd}}{{/if}}{{#if this.nota}} <span style="opacity:0.7;">({{this.nota}})</span>{{/if}}</div>
            {{/each}}
          </div>
          {{/if}}
          {{#each carrinho}}
          <div class="t20w-cart-row" style="display:flex;align-items:center;gap:4px;font-size:0.82em;">
            <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{name}}</span>
            {{#if (gt qty 1)}}<span style="opacity:0.6;">×{{qty}}</span>{{/if}}
            <span style="white-space:nowrap;opacity:0.8;">{{preco}} T$</span>
            <button type="button" class="t20w-btn-sm" data-action="equipRemoveAll" data-id="{{id}}" title="Tirar do carrinho"
              style="width:18px;height:18px;padding:0;font-size:0.9em;line-height:1;cursor:pointer;flex-shrink:0;">×</button>
          </div>
          {{else}}
          {{#unless gratis.length}}
          <p style="font-size:0.8em;opacity:0.5;margin:0;">Nenhum item selecionado.</p>
          {{/unless}}
          {{/each}}
          {{#if carrinho.length}}
          <div style="border-top:1px solid rgba(255,255,255,0.15);margin-top:4px;padding-top:4px;font-size:0.85em;font-weight:600;">
            Total: {{dinheiroGasto}} T$
          </div>
          {{/if}}
        </div>
      </div>

    </section>
    {{/if}}

    {{#if showRevisao}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <div class="t20w-revisao">
        <div class="t20w-card t20w-largo">
          <div class="t20w-row t20w-wrap" style="justify-content:space-between;">
            <div>
              <div style="font-size:1.3em;font-weight:700;">{{nome}}</div>
              <div class="t20w-hint">{{racaNome}} · {{classesTexto}} · nível {{nivel}}{{#if divindadeNome}} · devoto de {{divindadeNome}}{{/if}}</div>
              <div class="t20w-hint">Origem: {{origemNome}}</div>
              {{#each idadeResumo}}<div class="t20w-hint">{{this}}</div>{{/each}}
            </div>
          </div>
          <div class="t20w-atributos" style="margin-top:10px;">
            {{#each atributos}}
            <div class="t20w-atributo">
              <div class="t20w-sigla">{{this.label}}</div>
              <div class="t20w-valor">{{#if (gt this.value 0)}}+{{/if}}{{this.value}}</div>
              {{#if this.racial}}<div class="t20w-detalhe">{{this.base}} {{#if (gt this.racial 0)}}+{{/if}}{{this.racial}} raça{{#if this.idade}} {{this.idade}} idade{{/if}}</div>{{else}}{{#if this.idade}}<div class="t20w-detalhe">{{this.base}} {{this.idade}} idade</div>{{/if}}{{/if}}
            </div>
            {{/each}}
          </div>
        </div>

        <div class="t20w-card">
          <h3>Perícias treinadas</h3>
          <div class="t20w-tags">{{#each resumo.pericias}}<span class="t20w-tag">{{this}}</span>{{else}}<span class="t20w-hint">nenhuma</span>{{/each}}</div>
        </div>
        <div class="t20w-card">
          <h3>Habilidades de classe</h3>
          <div class="t20w-tags">{{#each resumo.habilidades}}<span class="t20w-tag">{{this}}</span>{{else}}<span class="t20w-hint">nenhuma</span>{{/each}}</div>
        </div>
        <div class="t20w-card">
          <h3>Poderes ({{poderesSelecionados}})</h3>
          <div class="t20w-tags">{{#each resumo.poderes}}<span class="t20w-tag">{{this}}</span>{{else}}<span class="t20w-hint">nenhum</span>{{/each}}</div>
        </div>
        <div class="t20w-card">
          <h3>Magias ({{magiasSelecionadas}})</h3>
          <div class="t20w-tags">{{#each resumo.magias}}<span class="t20w-tag">{{this}}</span>{{else}}<span class="t20w-hint">nenhuma</span>{{/each}}</div>
        </div>
        <div class="t20w-card t20w-largo">
          <h3>Equipamento — T$ {{dinheiroRestante}} restantes</h3>
          <div class="t20w-tags">{{#each resumo.itens}}<span class="t20w-tag">{{this}}</span>{{else}}<span class="t20w-hint">nenhum item</span>{{/each}}</div>
        </div>
      </div>
      {{#if pendencias.length}}
      <div class="t20w-pendencias">
        <strong style="font-size:0.9em;">Falta para poder criar:</strong>
        <ul>
          {{#each pendencias}}<li>{{this}}</li>{{/each}}
        </ul>
      </div>
      {{/if}}
    </section>
    {{/if}}

    {{#if errors.length}}
    <ul class="t20w-errors">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
    {{/if}}

  </div>

  <footer class="t20w-footer">
    {{#if showBack}}<button type="button" class="t20w-btn" data-action="back">← Voltar</button>{{else}}<span></span>{{/if}}
    <span class="t20w-espaco"></span>
    {{#if showNext}}<button type="button" class="t20w-btn primaria" data-action="next">Próximo →</button>{{/if}}
    {{#if showCreate}}<button type="button" class="t20w-btn primaria" data-action="create" {{#unless isComplete}}disabled title="Resolva as pendências acima"{{/unless}}>✦ Criar Personagem</button>{{/if}}
  </footer>
</div>
