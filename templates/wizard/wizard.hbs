<div class="t20w-wizard" style="display:flex;flex-direction:column;height:100%;overflow:hidden;">
  <nav class="t20w-steps" style="display:flex;flex-wrap:wrap;gap:4px;padding:6px 4px;border-bottom:1px solid #444;">
    {{#each steps}}
      <button
        type="button"
        class="t20w-step-btn {{#if this.active}}active{{/if}} {{#if this.done}}done{{/if}}"
        data-action="goStep"
        data-step="{{this.id}}"
        {{#unless this.reachable}}disabled{{/unless}}
        style="padding:2px 6px;font-size:0.75em;{{#if this.active}}outline:1px solid #f90;{{/if}}"
      >{{localize this.label}}</button>
    {{/each}}
  </nav>

  <div class="t20w-content" style="flex:1;overflow-y:auto;padding:8px 12px;">

    {{#if showNivel}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <div class="form-group">
        <label for="t20w-nivel">Nível</label>
        <input id="t20w-nivel" type="number" name="nivel" min="1" max="20" value="{{state.nivel}}" />
      </div>
      <div class="form-group">
        <label for="t20w-nome">Nome do Personagem</label>
        <input id="t20w-nome" type="text" name="nome" value="{{state.nome}}" placeholder="Nome..." />
      </div>
    </section>
    {{/if}}

    {{#if showAtributos}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <div class="form-group">
        <label>Método</label>
        <select name="metodoAtributos">
          {{#each metodos}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.nome}} ({{this.categoria}})</option>
          {{/each}}
        </select>
      </div>
      <div style="display:flex;flex-direction:column;gap:6px;margin-top:8px;">
        {{#each atributos}}
        <div class="t20w-attr-row" style="display:flex;align-items:center;gap:8px;">
          <span style="width:110px;font-size:0.9em;">{{this.label}}</span>
          <button type="button" class="t20w-btn-sm" data-action="attrDec" data-attr="{{this.id}}" style="width:26px;height:26px;padding:0;font-size:1em;line-height:1;cursor:pointer;">−</button>
          <input type="number" name="attr-{{this.id}}" value="{{this.value}}"
            class="t20w-attr-input"
            data-attr="{{this.id}}"
            style="width:52px;text-align:center;"
            {{#if ../isCompra}}min="-1" max="4"{{/if}} />
          <button type="button" class="t20w-btn-sm" data-action="attrInc" data-attr="{{this.id}}" style="width:26px;height:26px;padding:0;font-size:1em;line-height:1;cursor:pointer;">+</button>
          {{#if ../isCompra}}<span style="font-size:0.8em;opacity:0.7;width:60px;">custo: {{this.custo}}</span>{{/if}}
        </div>
        {{/each}}
      </div>
      {{#if isCompra}}
      <p style="margin-top:10px;font-size:0.9em;">
        Pontos restantes: <strong id="t20w-pontos-restantes" class="{{#if pontosNegativo}}t20w-over{{/if}}">{{pontosRestantes}}</strong> / {{pontosTotal}}
      </p>
      {{else}}
      <div class="t20w-roll-bar" style="margin-top:10px;">
        <p class="t20w-hint" style="margin:0 0 6px;">
          <strong>{{metodoDescricao}}</strong> — insira os valores ou clique em Rolar.
        </p>
        <button type="button" data-action="rollAtributos" class="t20w-btn" style="padding:4px 12px;cursor:pointer;">🎲 Rolar Atributos</button>
      </div>
      {{/if}}
    </section>
    {{/if}}

    {{#if showRaca}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <div class="form-group">
        <label for="t20w-raca-sel">Raça</label>
        <select id="t20w-raca-sel" name="racaId" style="width:100%;padding:6px;">
          <option value="">— escolha uma raça —</option>
          {{#each racaOptions}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </div>
      {{#if selectedDetail}}
      <div style="margin-top:12px;padding:10px;background:rgba(255,255,255,0.05);border-radius:4px;">
        <h3 style="margin:0 0 6px;">{{selectedDetail.name}}</h3>
        {{#if selectedDetail.descricao}}<p style="font-size:0.85em;opacity:0.8;margin:0 0 8px;">{{selectedDetail.descricao}}</p>{{/if}}
        <dl style="display:grid;grid-template-columns:max-content 1fr;gap:2px 12px;font-size:0.85em;margin:0;">
          {{#if selectedDetail.atributosTexto}}<dt>Atributos</dt><dd>{{selectedDetail.atributosTexto}}</dd>{{/if}}
          <dt>Tamanho</dt><dd>{{selectedDetail.tamanho}}</dd>
          <dt>Deslocamento</dt><dd>{{selectedDetail.deslocamento}}m</dd>
          {{#if selectedDetail.pericias_bonus.length}}<dt>Perícias bônus</dt><dd>{{selectedDetail.pericias_bonus}}</dd>{{/if}}
        </dl>
        {{#each selectedDetail.modGroups}}
        <div style="margin-top:10px;">
          <strong style="font-size:0.85em;">+{{this.valor}} em {{this.quantidade}} atributo(s){{#if this.diferentes}} diferentes{{/if}}:</strong>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;">
            {{#each this.slots}}
            <select name="raca_mod-{{this.groupIndex}}-{{this.slotIndex}}" style="padding:4px;">
              <option value="">—</option>
              {{#each this.opcoes}}
              <option value="{{this.code}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
            {{/each}}
          </div>
        </div>
        {{/each}}
      </div>
      {{/if}}
      {{#if errors.length}}<ul class="t20w-errors">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    </section>
    {{/if}}

    {{#if showOrigem}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <div class="form-group">
        <label for="t20w-origem-sel">Origem</label>
        <select id="t20w-origem-sel" name="origemId" style="width:100%;padding:6px;">
          <option value="">— escolha uma origem —</option>
          {{#each origemOptions}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.nome}}</option>
          {{/each}}
        </select>
      </div>
      {{#if selectedDetail}}
      <div style="margin-top:12px;padding:10px;background:rgba(255,255,255,0.05);border-radius:4px;">
        <h3 style="margin:0 0 6px;">{{selectedDetail.nome}}</h3>
        {{#if selectedDetail.pericias.length}}<p style="font-size:0.85em;margin:0 0 4px;"><strong>Perícias:</strong> {{#each selectedDetail.pericias}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
        {{#if selectedDetail.itens_iniciais.length}}<p style="font-size:0.85em;margin:0 0 4px;"><strong>Itens iniciais:</strong></p><ul style="font-size:0.82em;margin:0 0 6px;padding-left:18px;">{{#each selectedDetail.itens_iniciais}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
        {{#if selectedDetail.poder_auto}}<p style="font-size:0.85em;margin:0 0 8px;"><strong>Poder automático:</strong> {{selectedDetail.poder_auto_nome}}</p>{{/if}}
        {{#if selectedDetail.pick2_candidates.length}}
        <div style="margin-top:8px;">
          <strong style="font-size:0.85em;">Escolha 1 poder adicional:</strong>
          <div style="display:flex;flex-direction:column;gap:4px;margin-top:6px;">
            {{#each selectedDetail.pick2_candidates}}
            <label for="origem-poder-{{this.id}}" style="display:flex;align-items:center;gap:6px;font-size:0.9em;cursor:pointer;">
              <input type="radio" id="origem-poder-{{this.id}}" name="origem_poder_escolha" value="{{this.id}}" {{#if this.selected}}checked{{/if}} style="flex-shrink:0;" /><span style="cursor:pointer;">{{this.nome}}</span>
            </label>
            {{/each}}
          </div>
        </div>
        {{/if}}
      </div>
      {{/if}}
      {{#if errors.length}}<ul class="t20w-errors">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    </section>
    {{/if}}

    {{#if showClasse}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <div class="form-group">
        <label for="t20w-classe-sel">Classe</label>
        <select id="t20w-classe-sel" name="classeId" style="width:100%;padding:6px;">
          <option value="">— escolha uma classe —</option>
          {{#each classes}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </div>
      {{#if selectedClasse}}
      <div style="margin-top:12px;padding:10px;background:rgba(255,255,255,0.05);border-radius:4px;">
        <h3 style="margin:0 0 6px;">{{selectedClasse.name}}</h3>
        {{#if selectedClasse.system.descricao}}<p style="font-size:0.85em;opacity:0.8;margin:0 0 8px;">{{selectedClasse.system.descricao}}</p>{{/if}}
        <dl style="display:grid;grid-template-columns:max-content 1fr;gap:2px 12px;font-size:0.85em;margin:0;">
          <dt>PV por nível</dt><dd>+{{selectedClasse.system.pvPorNivel}}</dd>
          <dt>PM por nível</dt><dd>+{{selectedClasse.system.pmPorNivel}}</dd>
        </dl>
      </div>
      {{/if}}
      {{#if requiresCaminho}}
      <div class="t20w-caminho-section" style="margin-top:12px;padding:10px;background:rgba(255,255,255,0.05);border-radius:4px;">
        <strong style="font-size:0.9em;">Escolha seu Caminho:</strong>
        <div style="display:flex;flex-direction:column;gap:6px;margin-top:8px;">
          {{#each caminhos}}
          <label for="caminho-{{this.slug}}" style="display:flex;align-items:center;gap:8px;font-size:0.9em;cursor:pointer;width:100%;">
            <input type="radio" id="caminho-{{this.slug}}" name="classe_caminho" value="{{this.slug}}"
              {{#if this.selected}}checked{{/if}}
              style="flex-shrink:0;">
            <span style="cursor:pointer;">{{this.nome}}</span>
          </label>
          {{/each}}
        </div>
      </div>
      {{/if}}
      {{#if errors.length}}<ul class="t20w-errors">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    </section>
    {{/if}}

    {{#if showPericias}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      {{#unless hasClasse}}<p style="opacity:0.7;">Escolha uma classe antes de definir perícias.</p>{{/unless}}

      {{#if fixas.length}}
      <div style="margin-bottom:10px;">
        <strong style="font-size:0.85em;">Treinadas pela classe:</strong>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;">
          {{#each fixas}}<span style="font-size:0.8em;padding:2px 8px;background:#3a3a3a;border-radius:3px;">{{this.nome}}</span>{{/each}}
        </div>
      </div>
      {{/if}}

      {{#each obrigatorias}}
      <div style="margin-bottom:10px;">
        <strong style="font-size:0.85em;">Escolha {{this.quantidade}} (obrigatória):</strong>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;">
          {{#each this.opcoes}}
          <label style="font-size:0.9em;display:flex;align-items:center;gap:4px;">
            <input type="radio" name="per_obrig-{{../groupIndex}}" value="{{this.id}}" {{#if this.checked}}checked{{/if}} />{{this.nome}}
          </label>
          {{/each}}
        </div>
      </div>
      {{/each}}

      {{#if escolhasQtd}}
      <div style="margin-bottom:10px;">
        <strong style="font-size:0.85em;">Perícias da classe — escolha {{escolhasQtd}} (restam {{escolhasRestantes}}):</strong>
        <div class="t20w-pcheck-group" data-group="esc" data-max="{{escolhasQtd}}" style="display:grid;grid-template-columns:repeat(2,1fr);gap:2px 12px;margin-top:4px;max-height:200px;overflow-y:auto;">
          {{#each escolhasOpcoes}}
          <label style="font-size:0.88em;display:flex;align-items:center;gap:6px;" class="{{#if this.disabled}}t20w-disabled{{/if}}">
            <input type="checkbox" name="per_esc-{{this.id}}" value="{{this.id}}" {{#if this.checked}}checked{{/if}} {{#if this.disabled}}disabled{{/if}} />{{this.nome}}
          </label>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if intBonus}}
      <div style="margin-bottom:10px;">
        <strong style="font-size:0.85em;">Perícias extras por Inteligência — até {{intBonus}} (qualquer):</strong>
        <div class="t20w-pcheck-group" data-group="int" data-max="{{intBonus}}" style="display:grid;grid-template-columns:repeat(2,1fr);gap:2px 12px;margin-top:4px;max-height:160px;overflow-y:auto;">
          {{#each intOpcoes}}
          <label style="font-size:0.88em;display:flex;align-items:center;gap:6px;" class="{{#if this.disabled}}t20w-disabled{{/if}}">
            <input type="checkbox" name="per_int-{{this.id}}" value="{{this.id}}" {{#if this.checked}}checked{{/if}} {{#if this.disabled}}disabled{{/if}} />{{this.nome}}
          </label>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if racaBonus}}
      <div style="margin-bottom:10px;">
        <strong style="font-size:0.85em;">Perícias de raça — escolha {{racaBonus}} (qualquer):</strong>
        <div class="t20w-pcheck-group" data-group="raca" data-max="{{racaBonus}}" style="display:grid;grid-template-columns:repeat(2,1fr);gap:2px 12px;margin-top:4px;max-height:160px;overflow-y:auto;">
          {{#each racaOpcoes}}
          <label style="font-size:0.88em;display:flex;align-items:center;gap:6px;" class="{{#if this.disabled}}t20w-disabled{{/if}}">
            <input type="checkbox" name="per_raca-{{this.id}}" value="{{this.id}}" {{#if this.checked}}checked{{/if}} {{#if this.disabled}}disabled{{/if}} />{{this.nome}}
          </label>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if errors.length}}<ul class="t20w-errors">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    </section>
    {{/if}}

    {{#if showDivindade}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      {{#if obrigatoria}}<p style="color:#f90;font-size:0.9em;">⚠ Esta classe exige uma divindade.</p>
      {{else}}<p style="font-size:0.9em;opacity:0.7;">Opcional. Pule se não quiser ser devoto.</p>{{/if}}
      <div class="form-group">
        <label for="t20w-div-sel">Divindade</label>
        <select id="t20w-div-sel" name="divindadeId" style="width:100%;padding:6px;">
          <option value="">— nenhuma —</option>
          {{#each divindades}}
            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.nome}}</option>
          {{/each}}
        </select>
      </div>
      {{#if selectedDivindade}}
      <div style="margin-top:12px;padding:10px;background:rgba(255,255,255,0.05);border-radius:4px;">
        <h3 style="margin:0 0 6px;">{{selectedDivindade.nome}}</h3>
        {{#if todosPoderesAuto}}
          <p style="font-size:0.85em;opacity:0.75;margin:0 0 6px;">Como {{classeNome}}, você recebe todos os poderes concedidos automaticamente.</p>
          <ul style="font-size:0.85em;margin:0;padding-left:18px;">
            {{#each selectedDivindade.poderesConcedidos}}<li>{{this}}</li>{{/each}}
          </ul>
        {{else}}
          <p style="font-size:0.85em;margin:0 0 6px;"><strong>Escolha 1 poder concedido:</strong></p>
          <div class="t20w-poder-radio-group" data-selected-poder="{{divindadePoder}}" style="display:flex;flex-direction:column;gap:4px;">
            {{#each selectedDivindade.poderesConcedidos}}
            <label for="div-poder-{{@index}}" style="display:flex;align-items:center;gap:6px;font-size:0.9em;cursor:pointer;">
              <input type="radio" id="div-poder-{{@index}}" name="divindade_poder" value="{{this}}" style="flex-shrink:0;" />
              <span style="cursor:pointer;">{{this}}</span>
            </label>
            {{/each}}
          </div>
        {{/if}}
      </div>
      {{/if}}
      {{#if errors.length}}<ul class="t20w-errors">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    </section>
    {{/if}}

    {{#if showPoderes}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>

      {{#if habilidades.length}}
      <div style="margin-bottom:16px;">
        <h3 style="font-size:0.95em;margin:0 0 6px 0;opacity:0.8;">Habilidades de Classe</h3>
        <p class="t20w-hint" style="margin:0 0 6px 0;">Você recebe estas habilidades automaticamente:</p>
        <ul style="margin:0;padding-left:20px;">
          {{#each habilidades}}<li style="font-size:0.85em;">{{this.nome}}</li>{{/each}}
        </ul>
      </div>
      {{/if}}

      {{#if poderesParaPick}}
      <div>
        <h3 style="font-size:0.95em;margin:0 0 6px 0;opacity:0.8;">Escolha de Poderes</h3>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;flex-wrap:wrap;">
          <span style="font-size:0.9em;">Escolha <strong>{{poderesParaPick}}</strong> — Selecionados: <strong>{{selectedCount}}</strong></span>
          <select id="t20w-poder-cat" style="padding:4px 8px;background:rgba(255,255,255,0.08);border:1px solid #555;color:inherit;border-radius:3px;">
            <option value="">Todas as categorias</option>
            {{#each categorias}}<option value="{{this}}">{{this}}</option>{{/each}}
          </select>
          <input type="text" id="t20w-poder-search" placeholder="Filtrar poderes..."
                 style="flex:1;min-width:120px;padding:4px 8px;background:rgba(255,255,255,0.08);border:1px solid #555;color:inherit;border-radius:3px;" />
        </div>

        <div class="t20w-poderes-list" style="display:flex;flex-direction:column;gap:3px;max-height:340px;overflow-y:auto;">
          {{#each poderes}}
          <label class="t20w-poder-row"
                 data-poder-name="{{this.name}}"
                 data-poder-cat="{{this.tipo}}"
                 style="display:flex;align-items:flex-start;gap:8px;padding:6px 8px;background:rgba(255,255,255,0.04);border-radius:3px;cursor:pointer;{{#unless this.eligible}}opacity:0.55;{{/unless}}">
            <input type="checkbox" name="poder-{{this.id}}" value="{{this.id}}"
                   {{#if this.selected}}checked{{/if}} />
            <img src="{{this.img}}" style="width:24px;height:24px;object-fit:contain;flex-shrink:0;border-radius:2px;" onerror="this.style.display='none'" />
            <div style="flex:1;">
              <div style="display:flex;align-items:center;gap:8px;">
                <span style="font-size:0.9em;font-weight:600;">{{this.name}}</span>
                {{#if this.tipo}}<small style="opacity:0.55;font-size:0.72em;">{{this.tipo}}</small>{{/if}}
              </div>
              {{#if this.descricao}}<div style="font-size:0.78em;opacity:0.75;margin-top:2px;">{{this.descricao}}</div>{{/if}}
              {{#unless this.eligible}}
                <div style="color:#f77;font-size:0.72em;margin-top:2px;">Requer: {{#each this.unmet}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</div>
              {{/unless}}
            </div>
          </label>
          {{/each}}
        </div>
      </div>
      {{else}}
      {{#unless habilidades.length}}
      <p class="t20w-hint">Nenhuma habilidade ou poder disponível para esta classe/nível.</p>
      {{/unless}}
      {{/if}}

      {{#if errors.length}}<ul class="t20w-errors">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    </section>
    {{/if}}

    {{#if showMagias}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      {{#if isConjurador}}
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;flex-wrap:wrap;">
        <span style="font-size:0.9em;" class="{{#if atMaxLimit}}t20w-neg{{/if}}">Selecionadas: <strong>{{selectedCount}}</strong> / {{magiaLimit}}</span>
        {{#if atMaxLimit}}<span style="color:#f90;font-size:0.85em;">⚠ Limite atingido ({{magiaLimit}} magias)</span>{{/if}}
        <input type="text" id="t20w-magia-search" placeholder="Buscar magia..."
               value="{{magiaSearch}}"
               style="flex:1;min-width:120px;padding:4px 8px;background:rgba(255,255,255,0.08);border:1px solid #555;color:inherit;border-radius:3px;" />
      </div>
      {{#each magiasByCirculo}}
      <div style="margin-bottom:14px;">
        <h3 style="font-size:0.9em;margin:0 0 6px;opacity:0.8;">{{label}}</h3>
        <div style="display:flex;flex-direction:column;gap:3px;max-height:260px;overflow-y:auto;">
          {{#each magias}}
          <label style="display:flex;align-items:center;gap:8px;padding:5px 8px;background:rgba(255,255,255,0.04);border-radius:3px;cursor:pointer;{{#if this.selected}}outline:1px solid rgba(255,160,0,0.5);{{/if}}">
            <input type="checkbox" name="magia-{{this.id}}" value="{{this.id}}" {{#if this.selected}}checked{{/if}} />
            <img src="{{this.img}}" width="28" height="28" style="object-fit:contain;flex-shrink:0;border-radius:2px;" onerror="this.style.display='none'" />
            <div style="flex:1;">
              <span style="font-size:0.9em;font-weight:600;">{{this.name}}</span>
              <small style="opacity:0.6;margin-left:6px;">{{this.escola}}{{#if this.tipo}} · {{this.tipo}}{{/if}}</small>
            </div>
          </label>
          {{/each}}
        </div>
      </div>
      {{else}}
      <p class="t20w-hint" style="opacity:0.7;">Nenhuma magia disponível para esta classe/nível{{#if magiaSearch}} com esse filtro{{/if}}.</p>
      {{/each}}
      {{else}}
      <p class="t20w-hint">{{classeNome}} não conjura magias. Clique em Próximo.</p>
      {{/if}}
      {{#if errors.length}}<ul class="t20w-errors">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    </section>
    {{/if}}

    {{#if showEquipamento}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>

      <!-- Money display -->
      <div class="t20w-money-bar" style="display:flex;align-items:center;gap:10px;padding:6px 10px;background:rgba(255,255,255,0.06);border-radius:4px;margin-bottom:10px;flex-wrap:wrap;font-size:0.9em;">
        <span>Dinheiro inicial: <strong>{{dinheiroInicial}} T$</strong></span>
        {{#if isNivel1}}
          <button type="button" data-action="rollDinheiro" class="t20w-btn-sm" style="padding:2px 8px;cursor:pointer;">🎲 4d6</button>
        {{/if}}
        <span style="opacity:0.5;">|</span>
        <span>Gasto: {{dinheiroGasto}} T$</span>
        <span style="opacity:0.5;">|</span>
        <span class="{{#if dinheiroOk}}t20w-money-ok{{else}}t20w-neg{{/if}}" style="font-weight:600;">Restante: {{dinheiroRestante}} T$</span>
        {{#unless dinheiroOk}}<span style="color:#f55;font-size:0.85em;">⚠ Excedeu o orçamento!</span>{{/unless}}
      </div>

      <!-- Search -->
      <input type="text" id="t20w-equip-search" placeholder="Buscar item..." value="{{equipSearch}}"
        style="width:100%;box-sizing:border-box;padding:4px 8px;background:rgba(255,255,255,0.08);border:1px solid #555;color:inherit;border-radius:3px;margin-bottom:8px;" />

      <!-- Category tabs -->
      <div class="t20w-equip-tabs" style="display:flex;gap:4px;margin-bottom:8px;">
        <button type="button" class="t20w-tab{{#if (eq categoriaAtual 'arma')}} t20w-active{{/if}}"
          data-action="equipTab" data-categoria="arma"
          style="padding:4px 12px;border-radius:3px;cursor:pointer;{{#if (eq categoriaAtual 'arma')}}background:rgba(255,160,0,0.25);outline:1px solid #f90;{{else}}background:rgba(255,255,255,0.06);{{/if}}">Armas</button>
        <button type="button" class="t20w-tab{{#if (eq categoriaAtual 'armadura')}} t20w-active{{/if}}"
          data-action="equipTab" data-categoria="armadura"
          style="padding:4px 12px;border-radius:3px;cursor:pointer;{{#if (eq categoriaAtual 'armadura')}}background:rgba(255,160,0,0.25);outline:1px solid #f90;{{else}}background:rgba(255,255,255,0.06);{{/if}}">Armaduras</button>
        <button type="button" class="t20w-tab{{#if (eq categoriaAtual 'geral')}} t20w-active{{/if}}"
          data-action="equipTab" data-categoria="geral"
          style="padding:4px 12px;border-radius:3px;cursor:pointer;{{#if (eq categoriaAtual 'geral')}}background:rgba(255,160,0,0.25);outline:1px solid #f90;{{else}}background:rgba(255,255,255,0.06);{{/if}}">Geral</button>
        <button type="button" class="t20w-tab{{#if (eq categoriaAtual 'consumivel')}} t20w-active{{/if}}"
          data-action="equipTab" data-categoria="consumivel"
          style="padding:4px 12px;border-radius:3px;cursor:pointer;{{#if (eq categoriaAtual 'consumivel')}}background:rgba(255,160,0,0.25);outline:1px solid #f90;{{else}}background:rgba(255,255,255,0.06);{{/if}}">Consumíveis</button>
      </div>

      <div class="t20w-equip-layout" style="display:grid;grid-template-columns:1fr 220px;gap:10px;">
        <!-- Item list -->
        <div class="t20w-equip-list" style="display:flex;flex-direction:column;gap:3px;max-height:320px;overflow-y:auto;">
          {{#each itens}}
          <div class="t20w-equip-row{{#if selected}} t20w-selected{{/if}}{{#if isInitial}} t20w-initial{{/if}}"
            style="display:flex;align-items:center;gap:8px;padding:4px 8px;background:{{#if selected}}rgba(255,160,0,0.12){{else}}rgba(255,255,255,0.04){{/if}};border-radius:3px;font-size:0.85em;">
            <img src="{{img}}" width="24" height="24" alt="" style="object-fit:contain;flex-shrink:0;" onerror="this.style.display='none'" />
            <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{name}}</span>
            <span style="opacity:0.7;white-space:nowrap;">{{preco}} T$</span>
            <span style="opacity:0.5;white-space:nowrap;font-size:0.8em;">{{peso}} kg</span>
            {{#if isInitial}}
            <span style="font-size:0.75em;padding:1px 6px;background:rgba(0,180,100,0.25);border-radius:3px;color:#6f6;white-space:nowrap;">Inicial</span>
            {{else}}
            <button type="button" class="t20w-btn-sm"
              data-action="{{#if selected}}equipRemove{{else}}equipAdd{{/if}}"
              data-id="{{id}}"
              style="width:24px;height:24px;padding:0;font-size:1.1em;line-height:1;cursor:pointer;flex-shrink:0;">
              {{#if selected}}−{{else}}+{{/if}}
            </button>
            {{/if}}
          </div>
          {{else}}
          <p class="t20w-hint" style="opacity:0.6;font-size:0.85em;">Nenhum item nesta categoria{{#if equipSearch}} com esse filtro{{/if}}.</p>
          {{/each}}
        </div>

        <!-- Cart -->
        <div class="t20w-cart" style="background:rgba(255,255,255,0.04);border-radius:4px;padding:8px;display:flex;flex-direction:column;gap:4px;max-height:320px;overflow-y:auto;">
          <h4 style="margin:0 0 6px;font-size:0.9em;">Carrinho</h4>
          {{#if itensIniciais.length}}
          <div style="margin-bottom:6px;">
            <strong style="font-size:0.8em;opacity:0.8;">Itens de Origem (gratuitos):</strong>
            {{#each itensIniciais}}
            <div style="font-size:0.8em;padding:2px 4px;opacity:0.75;">{{name}}</div>
            {{/each}}
          </div>
          {{/if}}
          {{#each carrinho}}
          <div class="t20w-cart-row" style="display:flex;align-items:center;gap:4px;font-size:0.82em;">
            <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{name}}</span>
            {{#if (gt qty 1)}}<span style="opacity:0.6;">×{{qty}}</span>{{/if}}
            <span style="white-space:nowrap;opacity:0.8;">{{preco}} T$</span>
            <button type="button" class="t20w-btn-sm" data-action="equipRemove" data-id="{{id}}"
              style="width:18px;height:18px;padding:0;font-size:0.9em;line-height:1;cursor:pointer;flex-shrink:0;">×</button>
          </div>
          {{else}}
          {{#unless itensIniciais.length}}
          <p style="font-size:0.8em;opacity:0.5;margin:0;">Nenhum item selecionado.</p>
          {{/unless}}
          {{/each}}
          {{#if carrinho.length}}
          <div style="border-top:1px solid rgba(255,255,255,0.15);margin-top:4px;padding-top:4px;font-size:0.85em;font-weight:600;">
            Total: {{dinheiroGasto}} T$
          </div>
          {{/if}}
        </div>
      </div>

      {{#if errors.length}}<ul class="t20w-errors">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    </section>
    {{/if}}

    {{#if showRevisao}}
    <section class="t20w-step">
      <h2>{{stepTitle}}</h2>
      <dl class="t20w-summary">
        <dt>Nome</dt><dd>{{nome}}</dd>
        <dt>Nível</dt><dd>{{nivel}}</dd>
        <dt>Raça</dt><dd>{{racaNome}}</dd>
        <dt>Origem</dt><dd>{{origemNome}}</dd>
        <dt>Classe</dt><dd>{{classeNome}}</dd>
        {{#if divindadeNome}}<dt>Divindade</dt><dd>{{divindadeNome}}</dd>{{/if}}
      </dl>
      <table class="t20w-attrs-summary"><tbody>
        {{#each atributos}}<tr><th>{{this.label}}</th><td>{{this.value}}</td></tr>{{/each}}
      </tbody></table>
      <ul class="t20w-summary-counts">
        <li>Poderes: {{poderesSelecionados}}</li>
        <li>Magias: {{magiasSelecionadas}}</li>
        <li>Equipamento: {{equipamentoSelecionado}} item(s)</li>
        <li>Dinheiro restante: T$ {{dinheiroRestante}}</li>
      </ul>
    </section>
    {{/if}}

    {{#if errors.length}}
    <ul class="t20w-errors">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
    {{/if}}

  </div>

  <footer class="t20w-footer" style="flex-shrink:0;padding:8px 12px;border-top:1px solid #555;display:flex;gap:8px;">
    {{#if showBack}}<button type="button" data-action="back">← Voltar</button>{{/if}}
    {{#if showNext}}<button type="button" data-action="next">Próximo →</button>{{/if}}
    {{#if showCreate}}<button type="button" data-action="create">✦ Criar Personagem</button>{{/if}}
  </footer>
</div>
