<section class="t20w-step t20w-step-nivel">
  <h2>{{stepTitle}}</h2>

  <div class="form-group">
    <label for="t20w-nivel">Nível</label>
    <input id="t20w-nivel" type="number" name="nivel" min="1" max="20" value="{{state.nivel}}" />
  </div>

  <div class="form-group">
    <label for="t20w-nome">Nome do Personagem</label>
    <input id="t20w-nome" type="text" name="nome" value="{{state.nome}}" placeholder="Nome..." />
  </div>

  {{#if errors.length}}
    <ul class="t20w-errors">
      {{#each errors}}<li>{{this}}</li>{{/each}}
    </ul>
  {{/if}}
</section>